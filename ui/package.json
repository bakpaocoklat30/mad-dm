{
  "name": "mad-dm-desktop",
  "version": "1.0.0",
  "description": "MAD-DM Accelerated Download Manager Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.maddm.app",
    "productName": "MAD-DM",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../bin",
        "to": "bin",
        "filter": ["*"]
      },
      {
        "from": "../extension",
        "to": "extension",
        "filter": ["*"]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
